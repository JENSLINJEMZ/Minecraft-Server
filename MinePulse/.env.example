# =====================================================================
# MinePulse environment (PLACEHOLDERS ONLY - copy this file to .env)
# Never commit a real .env. Generate your own secrets.
# =====================================================================

NODE_ENV=development

# ---- API ----
API_PORT=4000
API_BIND=127.0.0.1

# Comma-separated list of allowed browser origins (dashboard dev server).
# Include BOTH localhost and 127.0.0.1 so it does not matter which one you open.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (SQLite via Prisma) ----
DATABASE_URL="file:./data/minepulse.db"

# ---- Auth / sessions ----
# Generate a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_long_random_secret

# ---- Alerting ----
# Heartbeat older than this (seconds) marks the server offline. Agent silence marks it stale.
HEARTBEAT_OFFLINE_SECONDS=60
HEARTBEAT_STALE_SECONDS=30

# Discord webhook for alert delivery. Leave blank to disable (UI will show "not configured").
DISCORD_WEBHOOK_URL=

# ---- Dashboard (Vite, exposed to browser) ----
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
